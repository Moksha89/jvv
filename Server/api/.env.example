# Server Configuration
API_PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRY=24h
SESSION_INACTIVITY_TIMEOUT_MS=1800000

# Database
DB_PATH=./data/relay.db

# Guacamole
GUAC_BASE_URL=https://remote.newsreporter.live

# Dashboard
DASHBOARD_DIR=..
DASHBOARD_TOKEN_SECRET=change-this-to-a-strong-random-secret

# FRP
FRP_DASHBOARD_PORT=7500

# AI / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Unsplash
UNSPLASH_ACCESS_KEY=

# TMDb
TMDB_API_KEY=

# YouTube
YOUTUBE_API_KEY=
